<resources>
<style name="Base.Theme.ThucHanh" parent="Theme.Material3.Light.NoActionBar">
<item name="colorPrimary">@color/teal</item>
<item name="colorOnPrimary">#FFFFFF</item>
<item name="colorSecondary">@color/teal</item>
<item name="android:fontFamily">sans</item>
<item name="android:windowBackground">@color/page</item>
<item name="android:colorBackground">@color/page</item>
<item name="android:textColorPrimary">@color/ink</item>
<item name="android:textColorSecondary">@color/muted</item>
<item name="android:windowLightStatusBar">true</item>
<item name="materialButtonStyle">@style/AppButton</item>
</style>
<style name="Theme.ThucHanh" parent="Base.Theme.ThucHanh"/>
<style name="AppButton" parent="Widget.Material3.Button">
<item name="cornerRadius">16dp</item>
<item name="android:minHeight">56dp</item>
<item name="android:textSize">16sp</item>
<item name="android:textAllCaps">false</item>
</style>
<style name="ScreenTitle">
<item name="android:textSize">28sp</item>
<item name="android:textStyle">bold</item>
<item name="android:textColor">@color/ink</item>
<item name="android:layout_marginTop">16dp</item>
<item name="android:layout_marginBottom">8dp</item>
</style>
<style name="FieldLabel">
<item name="android:textSize">14sp</item>
<item name="android:textStyle">bold</item>
<item name="android:textColor">@color/muted</item>
<item name="android:layout_marginTop">18dp</item>
<item name="android:layout_marginBottom">8dp</item>
</style>
<style name="FormInput">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">56dp</item>
<item name="android:padding">14dp</item>
<item name="android:background">@drawable/input</item>
<item name="android:textSize">16sp</item>
<item name="android:textColor">@color/ink</item>
</style>
</resources>
